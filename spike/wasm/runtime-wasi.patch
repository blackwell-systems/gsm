diff -ru a/runtime/caml/fail.h b/runtime/caml/fail.h
--- a/runtime/caml/fail.h
+++ b/runtime/caml/fail.h
@@ -16,7 +16,7 @@
 #ifndef CAML_FAIL_H
 #define CAML_FAIL_H
 
-#ifdef CAML_INTERNALS
+#if defined(CAML_INTERNALS) && !defined(__wasi__)
 #include <setjmp.h>
 #endif /* CAML_INTERNALS */
 
@@ -45,7 +45,18 @@
 #define ASSERT_FAILURE_EXN 10   /* "Assert_failure" */
 #define UNDEFINED_RECURSIVE_MODULE_EXN 11 /* "Undefined_recursive_module" */
 
-#ifdef POSIX_SIGNALS
+#if defined(__wasi__)
+/* WASI preview 1 has no setjmp/longjmp without the exception-handling
+   proposal. An exception raised from C (a runtime primitive) cannot unwind to
+   an OCaml handler; it is reported as uncaught (exit 2), so the process fails
+   closed. Exceptions raised from OCaml code are unaffected (the interpreter
+   handles them without longjmp). */
+struct longjmp_buffer {
+  int unused;
+};
+#define sigsetjmp(buf,save) 0
+#define siglongjmp(buf,val) caml_fatal_uncaught_exception(Caml_state->exn_bucket)
+#elif defined(POSIX_SIGNALS)
 struct longjmp_buffer {
   sigjmp_buf buf;
 };
diff -ru a/runtime/caml/mlvalues.h b/runtime/caml/mlvalues.h
--- a/runtime/caml/mlvalues.h
+++ b/runtime/caml/mlvalues.h
@@ -188,7 +188,13 @@
 #define Tag_hp(hp) (((unsigned char *) (hp)) [sizeof(value)-1])
                                                  /* Also an l-value. */
 #else
+#ifdef __wasi__
+/* On wasm32, -sizeof(value) is a large unsigned 32-bit offset, which clang
+   folds into a load offset that does not wrap: use a signed offset. */
+#define Tag_val(val) (((unsigned char *) (val)) [-(int)sizeof(value)])
+#else
 #define Tag_val(val) (((unsigned char *) (val)) [-sizeof(value)])
+#endif
                                                  /* Also an l-value. */
 #define Tag_hp(hp) (((unsigned char *) (hp)) [0])
                                                  /* Also an l-value. */
